# Copy to config.local.mk to override build settings.
# Command-line assignments still win: make iso HOSTNAME=fileserver

# HOSTNAME = fileserver
# TIMEZONE = America/New_York
# ADMIN_USER = agent
# Limit clearpart to one disk only if the installer lists that exact name.
# BOOT_DRIVE = nvme0n1
# ROOT_SIZE_MB = 12288
# SWAP_SIZE_MB = 2048
# Recovery filesystem mounted at /mnt/recovery_data, label RECOVER_DATA.
# RECOVERY_SIZE_MB = 32768
# VIRT_UEFI = 1
