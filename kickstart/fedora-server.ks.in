# Fedora @FEDORA_RELEASE@ Server kickstart.
# Generated from this template. Edit this file, then run make ks.
#
# make iso wipes every disk on the machine that boots it, unless BOOT_DRIVE
# is set. make image installs into a new disk image and does not use BOOT_DRIVE.
# / is labeled PRIMARY_ROOT and grows to fill the disk. /opt is a directory on /.
# The install source is the Fedora Server network tree used by the netinstall ISO.
# The package set is the core group plus a few admin tools.

text
skipx
lang en_US.UTF-8
keyboard --vckeymap=us --xlayouts='us'
timezone @TIMEZONE@ --utc
timesource --ntp-pool=0.fedora.pool.ntp.org
selinux --enforcing
firewall --disabled
network --hostname=@HOSTNAME@ --bootproto=dhcp --device=link --activate --onboot=yes
@AUTH@
@BOOTLOADER@
@PARTITIONING@
@INSTALL_SOURCE@
firstboot --disable
@FINISH@

%packages --excludedocs
@core
make
rsync
podman
tree
htop
btop
sysstat
vim
-initial-setup
-initial-setup-gui
-cockpit*
-firewalld
%end

%post --log=/root/ks-post.log --erroronfail
systemctl set-default multi-user.target
systemctl enable sshd.service podman.socket
systemctl mask cockpit.socket cockpit.service firewalld.service
cat > /etc/sudoers.d/@ADMIN_USER@ <<'EOF'
@ADMIN_USER@ ALL=(ALL) NOPASSWD: ALL
EOF
chmod 440 /etc/sudoers.d/@ADMIN_USER@
visudo -cf /etc/sudoers.d/@ADMIN_USER@
install -d -m 0755 /etc/issue.d
cat > /etc/issue.d/ipaddr.issue <<'EOF'
IP address: \4

EOF
%end
