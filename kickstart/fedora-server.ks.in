# Fedora @FEDORA_RELEASE@ Server kickstart.
# Generated from this template. Edit this file, then run make ks.
#
# make iso wipes every disk on the machine that boots it, unless BOOT_DRIVE
# is set. make image installs into a new disk image and does not use BOOT_DRIVE.
# / is labeled PRIMARY_ROOT and grows to fill the disk. A fixed XFS volume
# labeled RECOVER_DATA is mounted at /mnt/recovery_data. /opt is a directory on /.
# The install source is the Fedora Server network tree used by the netinstall ISO.
# The package set is the core group, plus make, rsync, podman, and the
# recovery tools. The recovery scripts are copied to /usr/local/sbin, then
# auto-reset.sh installs the boot hook and update-baseline.sh captures /.

text
skipx
lang en_US.UTF-8
keyboard --vckeymap=us --xlayouts='us'
timezone @TIMEZONE@ --utc
timesource --ntp-pool=0.fedora.pool.ntp.org
selinux --enforcing
firewall --disabled
network --hostname=@HOSTNAME@ --bootproto=dhcp --device=link --activate --onboot=yes
@AUTH@
@BOOTLOADER@
@PARTITIONING@
@INSTALL_SOURCE@
firstboot --disable
@FINISH@

%packages --excludedocs
@core
make
rsync
podman
bmap-tools
python3
dracut
tree
htop
btop
sysstat
vim
-initial-setup
-initial-setup-gui
-cockpit*
-firewalld
%end

%post --log=/root/ks-post.log --erroronfail
systemctl set-default multi-user.target
systemctl enable sshd.service podman.socket
systemctl mask cockpit.socket cockpit.service firewalld.service
cat > /etc/sudoers.d/@ADMIN_USER@ <<'EOF'
@ADMIN_USER@ ALL=(ALL) NOPASSWD: ALL
EOF
chmod 440 /etc/sudoers.d/@ADMIN_USER@
visudo -cf /etc/sudoers.d/@ADMIN_USER@
install -d -m 0755 /etc/issue.d
cat > /etc/issue.d/ipaddr.issue <<'EOF'
IP address: \4

EOF
@RECOVERY_INSTALL@
dnf -y upgrade --refresh
# Files written in %post (fstab, ld.so.cache, ...) can carry the wrong SELinux
# label. Systemd then cannot read fstab, / stays read-only, and sshd fails.
# Relabel before the baseline is captured so restores get correct labels.
restorecon -RF -e /mnt/recovery_data /
/usr/local/sbin/auto-reset.sh
/usr/local/sbin/update-baseline.sh
%end
